# Copy to an ignored .dev.vars locally; never reuse co-op/TURN/admin credentials.
# Put production values in Worker secrets, not wrangler vars or Git.
GOOGLE_CLIENT_ID=SET-LOCALLY
GOOGLE_CLIENT_SECRET=SET-LOCALLY
SESSION_SIGNING_KEY=GENERATE-A-NEW-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
IP_HASH_SECRET=GENERATE-A-DIFFERENT-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
